	component mat_ua_ni2 is
		port (
			clk_clk     : in  std_logic                    := 'X'; -- clk
			leds_export : out std_logic_vector(3 downto 0);        -- export
			uart_rxd    : in  std_logic                    := 'X'; -- rxd
			uart_txd    : out std_logic                            -- txd
		);
	end component mat_ua_ni2;

