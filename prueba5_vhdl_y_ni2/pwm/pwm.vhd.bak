library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity pwm is
  port (
    clk      : in  std_logic;                -- 50 MHz
    reset_n  : in  std_logic;
    angle    : in  std_logic_vector(7 downto 0); -- 0–180
    pwm_out  : out std_logic
  );
end entity;

architecture rtl of pwm is
  signal counter     : integer range 0 to 1_000_000 := 0;
  signal pulse_width : integer range 50_000 to 100_000;
begin

  -- Ángulo → ancho de pulso (1ms a 2ms)
  pulse_width <= 50_000 +
     (to_integer(unsigned(angle)) * 50_000) / 180;

  process(clk)
  begin
    if rising_edge(clk) then
      if reset_n = '0' then
        counter <= 0;
        pwm_out <= '0';
      else
        if counter = 1_000_000 then
          counter <= 0;
        else
          counter <= counter + 1;
        end if;

        if counter < pulse_width then
          pwm_out <= '1';
        else
          pwm_out <= '0';
        end if;
      end if;
    end if;
  end process;

end architecture;
