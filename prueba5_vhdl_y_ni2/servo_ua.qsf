set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M08SCE144C8G
set_global_assignment -name TOP_LEVEL_ENTITY servo_ua_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 17.1.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "13:00:30  DECEMBER 24, 2025"
set_global_assignment -name LAST_QUARTUS_VERSION "17.1.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 144
set_global_assignment -name DEVICE_FILTER_SPEED_GRADE 8
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name FLOW_ENABLE_POWER_ANALYZER ON
set_global_assignment -name POWER_DEFAULT_INPUT_IO_TOGGLE_RATE "12.5 %"
set_global_assignment -name QIP_FILE servo_ua/synthesis/servo_ua.qip
set_global_assignment -name VHDL_FILE pwm/pwm.vhd
set_global_assignment -name VHDL_FILE servo_ua_top.vhd
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_location_assignment PIN_74 -to reset_n
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to scl_pin
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to sda_pin
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to servo_pin
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to uart_rxd
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to uart_txd
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to clk
set_location_assignment PIN_29 -to uart_tx
set_location_assignment PIN_32 -to uart_rx
set_location_assignment PIN_10 -to servo_pwm
set_location_assignment PIN_26 -to clk_50
set_location_assignment PIN_11 -to i2c_scl
set_location_assignment PIN_12 -to i2c_sda
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to servo_pwm
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to i2c_sda
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to i2c_scl
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top